<!--
    命中血肉：一小团暗红雾 + 几滴下坠。

    一次性喷发的写法是 activetime > 0 且 inactivetime = 0：ParticleEmitter.cpp:119-137
    里 activetime 到点就停止发射，而 inactivetime 为 0 表示"永不重新激活"。反过来
    activetime=0 是永久发射（引擎自带的 Dust.xml 就是那种，适合常驻烟雾）。
    即便这样，Fx.lua 仍会在 lifetime 到点后 Remove 掉节点，双保险。

    emissionrate × activetime ≈ 实际粒子数（400 × 0.06 ≈ 24），numparticles 是上限。
    relative=false：粒子一旦喷出就留在世界空间，不跟着发射器跑。
-->
<particleeffect>
    <material name="Materials/ParticleSoft.xml" />
    <numparticles value="24" />
    <updateinvisible enable="false" />
    <relative enable="false" />
    <scaled enable="true" />
    <sorted enable="true" />
    <emittertype value="Sphere" />
    <emittersize value="0.08 0.08 0.08" />
    <direction min="-0.7 0.1 -0.7" max="0.7 1.0 0.7" />
    <constantforce value="0 -3.0 0" />
    <dampingforce value="0.4" />
    <activetime value="0.06" />
    <inactivetime value="0" />
    <emissionrate min="360" max="440" />
    <particlesize min="0.09 0.09" max="0.16 0.16" />
    <timetolive min="0.30" max="0.55" />
    <velocity min="0.9" max="2.4" />
    <rotation min="0" max="360" />
    <rotationspeed min="-90" max="90" />
    <sizedelta add="0.05" mul="1.0" />
    <colorfade color="0.60 0.09 0.09 0.85" time="0" />
    <colorfade color="0.28 0.04 0.04 0" time="0.55" />
</particleeffect>
