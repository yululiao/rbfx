<!--
    命中木头/沙土：土黄色碎屑，比血雾更"干"（初速更高、阻尼更小、寿命更短）。
    一次性喷发的约定见 Particle/HitFlesh.xml 的注释。
-->
<particleeffect>
    <material name="Materials/ParticleSoft.xml" />
    <numparticles value="20" />
    <updateinvisible enable="false" />
    <relative enable="false" />
    <scaled enable="true" />
    <sorted enable="true" />
    <emittertype value="Sphere" />
    <emittersize value="0.06 0.06 0.06" />
    <direction min="-0.8 0.2 -0.8" max="0.8 1.2 0.8" />
    <constantforce value="0 -6.0 0" />
    <dampingforce value="0.15" />
    <activetime value="0.05" />
    <inactivetime value="0" />
    <emissionrate min="320" max="400" />
    <particlesize min="0.06 0.06" max="0.12 0.12" />
    <timetolive min="0.22" max="0.42" />
    <velocity min="1.6" max="3.4" />
    <rotation min="0" max="360" />
    <rotationspeed min="-180" max="180" />
    <sizedelta add="-0.04" mul="1.0" />
    <colorfade color="0.72 0.58 0.34 0.9" time="0" />
    <colorfade color="0.45 0.34 0.19 0" time="0.42" />
</particleeffect>
