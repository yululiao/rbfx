@spritesheet theme
{
    src: /Textures/RmlUI-1x.png;

    close-button: 0dp 0dp 20dp 20dp;
    arrow-right: 20dp 0dp 16dp 16dp;
    arrow-down: 36dp 0dp 16dp 16dp;
    radio-dot: 20dp 16dp 16dp 16dp;
    check-mark: 36dp 16dp 16dp 16dp;
    resize-handle: 36dp 32dp 16dp 16dp;
}

/* ===== toy 主题贴图（Tools/gen_ui_toy.py 生成，改配色/尺寸要重跑脚本） =====
   按钮不再出贴图：底色/描边/圆角全走 dp 单位的原生 background/border，任何缩放下都是硬边。
   九宫格只留给面板 panel_dark（AI 手绘边框 826x561）。sprite 矩形里的 dp 只取数值，
   单位不参与换算（见 StyleSheetParser 里 Get<float>()），所以写的是原始像素。 */
@spritesheet panel_dark
{
    src: /Textures/UIStyle/ui_panel_dark.png;
    resolution: 1.82;
    panel_dark_outer: 0dp 0dp 826dp 561dp;
    panel_dark_inner: 36dp 36dp 754dp 489dp;
}

body
{
    font-family: "Noto Sans SC";
    font-weight: normal;
    font-style: normal;
    font-size: 16dp;
    color: white;
    display: inline-block;
    overflow: hidden;
}

#window
{
    background: #354343;
    border-top: 2dp #3d574a;
    border-bottom: 2dp #3d574a;
    border-left: 2dp #2b3939;
    border-right: 2dp #2b3939;
    padding: 8dp;
    border-radius: 6dp;
    min-width: 100dp;
    min-height: 100dp;
}

#titlebar
{
    text-align: left;
    margin: -8dp;
    padding: 4dp 8dp 4dp 8dp;
    border-bottom: 1dp #2b3939;
    height: 20dp;
}

#titlebar #title
{
    display: inline-block;
    width: 100%;
}

#content
{
    width: auto;
    overflow: hidden auto;
    margin: 0;
}

*:disabled
{
    color: gray;
    cursor: unavailable;
}

/* button：纯色底 + 描边 + 圆角，全走 RmlUi 原生 background/border，单位是 dp，任何缩放下
   都是硬边。早先的四色九宫格贴图会在按钮上叠出一圈半透方框（四角/边条采样与 dp 缩放耦合），
   故按钮不再挂 decorator；九宫格只留给面板 panel_dark。
   类决定底色：.btn_primary/.btn_secondary/.btn_accent/.btn_neutral/.btn_clear，无类落到中性 taupe。 */
button,
input.submit
{
    background-color: #9a8670ff;
    border: 3dp #4a3626ff;
    border-radius: 14dp;
    display: inline-block;
    text-align: center;
    padding: 10dp 26dp;
    margin-right: 4dp;
    tab-index: auto;
    font-weight: bold;
    color: #3b2a1cff;
}

.btn_primary
{
    background-color: #e05a3fff;
    color: #fff8eeff;
}

.btn_secondary
{
    background-color: #2e8b8bff;
    color: #fff8eeff;
}

.btn_accent
{
    background-color: #f0b23cff;
    color: #3b2a1cff;
}

.btn_neutral
{
    background-color: #9a8670ff;
    color: #3b2a1cff;
}

/* 语音面板的「清除」：和同排的录制/试听区分开，用琥珀橙而不是中性 taupe。 */
.btn_clear
{
    background-color: #cd8435ff;
    color: #3b2a1cff;
}

button:hover,
input.submit:hover
{
    background-color: #a89480ff;
}

.btn_primary:hover
{
    background-color: #ea6a4dff;
}

.btn_secondary:hover
{
    background-color: #37a0a0ff;
}

.btn_accent:hover
{
    background-color: #f6c05aff;
}

button:active,
input.submit:active
{
    background-color: #857361ff;
}

.btn_primary:active
{
    background-color: #c44a30ff;
}

.btn_secondary:active
{
    background-color: #257272ff;
}

.btn_accent:active
{
    background-color: #d29a2cff;
}

.btn_clear:hover
{
    background-color: #d79245ff;
}

.btn_clear:active
{
    background-color: #b3712cff;
}

input.submit:disabled
{
    background-color: #b8aa9aff;
}

/* X button */
.close-window
{
    border: 2dp #6b8a64;
    decorator: image(close-button), gradient(vertical #c45036 #7f2c24);
    border: 0dp;
    width: 20dp;
    height: 20dp;
    padding: 0;
    position: absolute;
    right: 3dp;
    top: 3dp;
}

.close-window:hover
{
    decorator: image(close-button), gradient(vertical #7f2c24 #c45036);
}

.close-window:active
{
    decorator: image(close-button), gradient(vertical #c45036 #7f2c24);
}

/* textarea */
textarea
{
    border: 1dp #2b3939;
    border-top: #3d584b;
    border-radius: 4dp;
    padding: 4dp;
    cursor: text;
    display: block;
    min-height: 100dp;
    min-width: 200dp;
    margin-top: 4dp;
}

/* 深色木质卡片（设置/语音/侧边栏面板）：AI 手绘边框 + 九宫格拉伸 */
.panel_card
{
    decorator: ninepatch(panel_dark_outer, panel_dark_inner);
}

/* checkbox, radio */
input.checkbox
{
    width: 16dp;
    height: 16dp;
    vertical-align: -3dp;
    margin-right: 4dp;
    border: 2dp #f4e7cf;
    border-radius: 5dp;
    background: #4a3626;
}

input.radio
{
    width: 16dp;
    height: 16dp;
    border: 1dp #45614a;
    border-bottom: 1dp #6a8963;
    border-radius: 0.5em;
}

input.checkbox:hover,
input.checkbox:checked:hover,
input.radio:hover,
input.radio:checked:hover
{
    background: #6b5137;
}

input.checkbox:checked
{
    decorator: image(check-mark);
}
input.radio:checked
{
    decorator: image(radio-dot);
}

/* range */
input.range
{
    height: 16dp;
    border-radius: 4dp;
    border: 1dp #2b3939;
    border-top: #3d584b;
    border-bottom: #3d584b;
}

/* text */
input.text,
input.password
{
    border: 1dp #2b3939;
    border-top: #3d584b;
    border-bottom: #3d584b;
    padding: 4dp;
    height: 20dp;
    border-radius: 5dp;
}

input.text:hover,
input.password:hover
{
    border-left: 1dp #45614a;
    border-right: 1dp #45614a;
    border-top: 1dp #6b8a64;
    border-bottom: 1dp #6b8a64;
}

/* select */
select
{
    border: 1dp #2b3939;
    border-top: #3d584b;
    border-bottom: #3d584b;
    border-radius: 5dp;
    padding: 0dp 4dp;
    margin-top: 4dp;
    height: 20dp;
}

select selectarrow
{
    width: 16dp;
    height: 16dp;
    decorator: image(arrow-down);
}

select selectbox
{
    border: 1dp #2b3939;
    border-top: 0;
    border-bottom: #3d584b;
    padding: 0 4dp;
    background: #354343;
    border-bottom-left-radius: 5dp;
    border-bottom-right-radius: 5dp;
}

select selectbox option:hover
{
    text-decoration: underline;
}

/* scrollbar */
scrollbarvertical, scrollbarhorizontal
{
    border: 1dp #3d584b;
    background: #354343;
    border-radius: 3dp;
}

scrollbarvertical
{
    width: 16dp;
    border-top: 0dp;
    border-bottom: 0dp;
}

scrollbarhorizontal
{
    height: 16dp;
    border-left: 0dp;
    border-right: 0dp;
}

scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec,
scrollbarhorizontal sliderarrowinc,
scrollbarhorizontal sliderarrowdec,
input.range sliderarrowinc,
input.range sliderarrowdec
{
    width: 16dp;
    height: 16dp;
    border: 1dp #45614a;
    border-top: #688762;
    border-radius: 3dp;
    decorator: gradient(vertical #3c5c4a #25413a);
}

scrollbarvertical sliderarrowdec
{
     decorator: image(arrow-down flip-vertical), gradient(vertical #3c5c4a #25413a);
}
scrollbarvertical sliderarrowinc
{
     decorator: image(arrow-down), gradient(vertical #3c5c4a #25413a);
}

scrollbarhorizontal sliderarrowdec,
input.range sliderarrowdec
{
     decorator: image(arrow-right flip-horizontal), gradient(vertical #3c5c4a #25413a);
}
scrollbarhorizontal sliderarrowinc,
input.range sliderarrowinc
{
     decorator: image(arrow-right), gradient(vertical #3c5c4a #25413a);
}

scrollbarvertical sliderarrowinc:hover
{
    decorator: image(arrow-down), gradient(vertical #3b785a #357e57);
}
scrollbarvertical sliderarrowdec:hover
{
    decorator: image(arrow-down flip-vertical),gradient(vertical #3b785a #357e57);
}
scrollbarhorizontal sliderarrowinc:hover,
input.range sliderarrowinc:hover
{
    decorator: image(arrow-right), gradient(vertical #3b785a #357e57);
}
scrollbarhorizontal sliderarrowdec:hover,
input.range sliderarrowdec:hover
{
    decorator: image(arrow-right flip-horizontal), gradient(vertical #3b785a #357e57);
}

sliderbar
{
    width: 16dp;
    height: 16dp;
    border: 1dp #45614a;
    border-top: #688762;
    border-radius: 3dp;
    decorator: gradient(vertical #3c5c4a #25413a);
}

sliderbar:hover
{
    decorator: gradient(vertical #3b785a #357e57);
}

sliderbar:active
{
    decorator: gradient(vertical #357e57 #3b785a);
}

scrollbarhorizontal > sliderbar
{
    width: auto;
}

scrollbarvertical > sliderbar
{
    height: auto;
}

/* progress：深棕凹槽 + 金色填充。条高只有 10dp，用九宫格贴图会把边框压到亚像素，
   所以这里保留纯色/渐变（圆角半径也小，硬边不明显），不再挂贴图。 */
progress
{
    display: block;
    border: 0dp;
    border-radius: 6dp;
    padding: 2dp;
    overflow: hidden;
    decorator: gradient(vertical #3f2c1e #6b4630);
}

progress.horizontal
{
    height: 20dp;
}

progress.vertical
{
    width: 20dp;
}

progress fill
{
    border: 0dp;
    border-radius: 4dp;
    decorator: gradient(vertical #ffd57a #f0a62e);
}

.resize-handle
{
    decorator: image(resize-handle);
    position: absolute;
    width: 16dp;
    height: 16dp;
    bottom: 1dp;
    right: 1dp;
    cursor: resize;
    clip: 1;
}

table {
    box-sizing: border-box;
    display: table;
}
tr {
    box-sizing: border-box;
    display: table-row;
}
td {
    box-sizing: border-box;
    display: table-cell;
}
col {
    box-sizing: border-box;
    display: table-column;
}
colgroup {
    display: table-column-group;
}
thead, tbody, tfoot {
    display: table-row-group;
}
