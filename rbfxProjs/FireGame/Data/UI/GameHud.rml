<!--
    GameHud.rml —— 玩法 HUD。动态值走数据模型绑定，Lua 侧改值后 MarkDirty(name) 刷新。
    绑定节点必须包在 <div data-model="{{__data_model_id}}"> 里（rbfx LuaRmlUIComponent 硬要求，见 107_HelloRmlUI）。

    数据绑定的三种合法写法（照 107_HelloRmlUI 与官方 Data/UI 样例，实测只有这三种）：
      * 文本：元素内容里写 {{name}}（BindReadonlyProperty 返回 string/number）。
      * 进度条：<progress data-value="name"/>，name 绑定 0..1 的数值 getter；填充样式来自 default.rcss 的 progress/progress fill。
      * 条件显隐：data-if="name"，name 绑定 bool getter；false 时元素整个不进渲染树。

    不支持的写法（会报 "Syntax error parsing property declaration"）：内联 style 里塞 {{name}}，
    例如 style="width: {{pct}}" / opacity / background-color / display —— RCSS 解析器直接吃到 {{ 就崩。
    所以血条用 <progress data-value>、hitmarker 与结算面板用 data-if，绝不在 style 里绑定。

    约定：
      * head 同时 link rml.rcss / layout.rcss（拿到 .fullscreen 与默认字体）+ default.rcss（主题、progress 样式）。
      * body class="fullscreen"，内部一律绝对定位，单位是画布像素（px 不随 SetScale 缩放）。
      * 颜色统一 RRGGBBAA 八位十六进制，不用 rgba()（会被 atoi 截断，见 RCSS 配色坑）。
      * 左下 #stick_ring 的几何（left40/bottom40/176x176）与 main.lua 的 STICK 常量、
        core/Joystick 的抓取判定是同一套，改这里必须同步改那里。
-->
<rml>
<head>
    <link type="text/rcss" href="rml.rcss"/>
    <link type="text/rcss" href="layout.rcss"/>
    <link type="text/rcss" href="default.rcss"/>
    <style>
        .bar_track { position: relative; background-color: #00000066; border-radius: 6px; overflow: hidden; }
        .label { color: #ffffffd9; font-size: 22px; }
        .big { color: #ffffffff; font-size: 64px; font-weight: bold; }
    </style>
</head>
<body class="fullscreen">
<div data-model="{{__data_model_id}}">

    <!-- 左上：波次 + 主角血 + 防线血 + 局内成长（等级/经验条）。两条血条靠标签区分（
         progress 填充色来自主题 default.rcss，不能内联改色，只能用文本标签辨别）。 -->
    <div style="position: absolute; left: 28px; top: 24px; width: 300px;">
        <div class="label">WAVE {{wave}}</div>
        <div class="label" style="margin-top: 8px; font-size: 18px; color: #ff6b6bff;">HP</div>
        <progress class="horizontal" data-value="playerHp" style="display: block; margin-top: 2px; width: 260px; height: 14px;"/>
        <div class="label" style="margin-top: 8px; font-size: 18px; color: #ffffffb3;">防线</div>
        <progress class="horizontal" data-value="defense" style="display: block; margin-top: 2px; width: 260px; height: 14px;"/>
        <div class="label" style="margin-top: 10px; font-size: 24px; color: #ffd24dff;">LV {{level}}</div>
        <progress class="horizontal" data-value="xp" style="display: block; margin-top: 4px; width: 260px; height: 10px;"/>
        <div class="label" style="margin-top: 6px; font-size: 18px; color: #ffffff99;">{{narrate}}</div>
    </div>

    <!-- 右上：分数 + combo -->
    <div style="position: absolute; right: 28px; top: 24px; width: 220px; text-align: right;">
        <div class="big">{{score}}</div>
        <div class="label" style="font-size: 30px; color: #ffd24dff;">{{comboText}}</div>
    </div>

    <!-- 准星已移除：改为王者式自动吸附开火（见 Shooting.lua），命中确认靠下面的 hitmarker。 -->

    <!-- 中央 hitmarker：普通命中(白) / 强命中(红)，靠 data-if 二选一显示（不支持内联 opacity 绑定） -->
    <div data-if="hitNormal" style="position: absolute; left: 50%; top: 50%; width: 0; height: 0;">
        <div style="position: absolute; left: -18px; top: -2px; width: 36px; height: 4px; background-color: #ffffffd9; transform: rotate(45deg);"></div>
        <div style="position: absolute; left: -18px; top: -2px; width: 36px; height: 4px; background-color: #ffffffd9; transform: rotate(-45deg);"></div>
    </div>
    <div data-if="hitStrong" style="position: absolute; left: 50%; top: 50%; width: 0; height: 0;">
        <div style="position: absolute; left: -20px; top: -3px; width: 40px; height: 6px; background-color: #ff4d4dff; transform: rotate(45deg);"></div>
        <div style="position: absolute; left: -20px; top: -3px; width: 40px; height: 6px; background-color: #ff4d4dff; transform: rotate(-45deg);"></div>
    </div>

    <!-- 右下：载具交互按钮，靠 data-if 显隐（登船=靠近船，下船=在船上），见 main.lua/Hud.lua -->
    <div data-if="showBoard" data-event-click="board" style="position: absolute; right: 196px; bottom: 168px; width: 96px; height: 96px; border-radius: 48px; background-color: #2e8b8be6; text-align: center;">
        <div style="position: relative; top: 32px; color: #ffffffff; font-size: 30px; font-weight: bold;">登船</div>
    </div>
    <div data-if="showDisembark" data-event-click="disembark" style="position: absolute; right: 196px; bottom: 168px; width: 96px; height: 96px; border-radius: 48px; background-color: #8b6b2ee6; text-align: center;">
        <div style="position: relative; top: 32px; color: #ffffffff; font-size: 30px; font-weight: bold;">下船</div>
    </div>

    <!-- 右下：弹药 + 装弹条 + 当前武器（弹丸数，随成长变化） -->
    <div style="position: absolute; right: 40px; bottom: 64px; width: 200px; text-align: right;">
        <div class="big">{{ammo}}</div>
        <progress class="horizontal" data-value="reload" style="display: block; margin-top: 6px; margin-left: 40px; width: 160px; height: 10px;"/>
        <div class="label" style="margin-top: 6px; font-size: 20px; color: #9fe0ffd9;">{{weaponText}}</div>
    </div>

    <!-- 右中：自定义语音入口（data-if="voiceAvailable"，编辑器宿主无 SDK 时隐藏）。
         放在摇杆与弹药之间右侧留白处，不挡操作。 -->
    <div data-if="voiceAvailable" data-event-click="voiceOpen" style="position: absolute; right: 44px; bottom: 300px; width: 84px; height: 84px; border-radius: 42px; background-color: #6a4b9ee6; text-align: center;">
        <div style="position: relative; top: 24px; color: #ffffffff; font-size: 26px; font-weight: bold;">配音</div>
    </div>

    <!-- 自定义语音面板（data-if="voicePanel"）：居中卡片。槽位两个（失败吐槽/连杀战吼），
         录音中提示与状态行都是绑定文本；音色按钮文本随循环切换。 -->
    <div data-if="voicePanel" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #00000080;">
        <div style="position: absolute; left: 50%; top: 50%; width: 600px; height: 520px;">
            <div style="position: absolute; left: -300px; top: -260px; width: 600px; height: 520px; background-color: #222831f2; border-radius: 20px;">
                <div style="position: relative; margin-top: 36px; text-align: center; color: #ffffffff; font-size: 40px; font-weight: bold;">自定义语音</div>
                <div style="position: relative; margin-top: 14px; text-align: center; color: #ffffffb3; font-size: 22px;">录一句话，防线被破/连杀时用你的声音播</div>

                <div style="position: relative; margin-top: 36px; margin-left: 60px;">
                    <div style="color: #ffffffd9; font-size: 26px;">失败吐槽（防线被破时播）</div>
                    <button data-event-click="voiceRecordLose" style="margin-top: 10px; padding: 14px 36px; font-size: 26px; background-color: #d94b3aff; color: #ffffffff; border-radius: 10px;">录一句</button>
                </div>

                <div style="position: relative; margin-top: 30px; margin-left: 60px;">
                    <div style="color: #ffffffd9; font-size: 26px;">连杀战吼（三杀及以上播）</div>
                    <button data-event-click="voiceRecordKillstreak" style="margin-top: 10px; padding: 14px 36px; font-size: 26px; background-color: #d94b3aff; color: #ffffffff; border-radius: 10px;">录一句</button>
                </div>

                <div data-if="voiceRecording" style="position: relative; margin-top: 24px; margin-left: 60px; color: #ffd24dff; font-size: 26px;">录音中…（最多几秒，说完自动停）</div>

                <div style="position: relative; margin-top: 28px; margin-left: 60px;">
                    <button data-event-click="voiceFilter" style="padding: 14px 32px; font-size: 26px; background-color: #2e8b8be6; color: #ffffffff; border-radius: 10px;">音色：{{voiceFilterName}}</button>
                    <button data-event-click="voicePreview" style="margin-left: 20px; padding: 14px 32px; font-size: 26px; background-color: #2e8b8be6; color: #ffffffff; border-radius: 10px;">试听</button>
                </div>

                <div style="position: relative; margin-top: 20px; margin-left: 60px; height: 34px; color: #ffffff99; font-size: 22px;">{{voiceStatus}}</div>

                <div style="position: relative; margin-top: 8px; text-align: center;">
                    <button data-event-click="voiceClose" style="padding: 14px 48px; font-size: 26px; background-color: #45586bcb; color: #ffffffff; border-radius: 10px;">完成</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 左下：虚拟摇杆底环（几何与 Joystick 判定共用，勿单独改）。
         会动的只有 Knob.rml 那颗帽（Lua 逐帧 SetPosition）。这里原先套过一个深色内圆，
         看起来像帽却永远不动，极易被误认为“帽不跟手”，已移除。 -->
    <div id="stick_ring" style="position: absolute; left: 40px; bottom: 40px; width: 176px; height: 176px; border-radius: 88px; background-color: #ffffff2e;"></div>

    <!-- 结算面板：data-if="gameOver"，未结束时整个不渲染 -->
    <div id="end_panel" data-if="gameOver" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000b3; text-align: center;">
        <div style="position: relative; top: 320px;">
            <div style="color: #ffffffff; font-size: 72px; font-weight: bold;">{{endTitle}}</div>
            <div class="label" style="margin-top: 16px; font-size: 34px;">SCORE {{endScore}}</div>
            <button data-event-click="restart" style="margin-top: 48px; padding: 18px 48px; font-size: 30px; background-color: #d94b3aff; color: #ffffffff; border-radius: 12px;">再来一局</button>
        </div>
    </div>

</div>
</body>
</rml>
