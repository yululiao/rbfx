<!--
    GameHud.rml —— 玩法 HUD。动态值走数据模型绑定，Lua 侧改值后 MarkDirty(name) 刷新。
    绑定节点必须包在 <div data-model="{{__data_model_id}}"> 里（rbfx LuaRmlUIComponent 硬要求，见 107_HelloRmlUI）。

    数据绑定的三种合法写法（照 107_HelloRmlUI 与官方 Data/UI 样例，实测只有这三种）：
      * 文本：元素内容里写 {{name}}（BindReadonlyProperty 返回 string/number）。
      * 进度条：<progress data-value="name"/>，name 绑定 0..1 的数值 getter；填充样式来自 default.rcss 的 progress/progress fill。
      * 条件显隐：data-if="name"，name 绑定 bool getter；false 时元素整个不进渲染树。

    不支持的写法（会报 "Syntax error parsing property declaration"）：内联 style 里塞 {{name}}，
    例如 style="width: {{pct}}" / opacity / background-color / display —— RCSS 解析器直接吃到 {{ 就崩。
    所以血条用 <progress data-value>、hitmarker 与结算面板用 data-if，绝不在 style 里绑定。

    约定：
      * head 同时 link rml.rcss / layout.rcss（拿到 .fullscreen 与默认字体）+ default.rcss（主题、progress 样式）。
      * body class="fullscreen"，内部一律绝对定位，单位用 dp（1dp = UI_SCALE 画布像素，
        缩放系数由 main.lua 按画布短边算出并 rmlUi:SetScale，小屏等比缩小适配）。
      * 颜色统一 RRGGBBAA 八位十六进制，不用 rgba()（会被 atoi 截断，见 RCSS 配色坑）。
      * 左下 #stick_ring 的几何（left40/bottom40/224x224，dp 基础值）与 main.lua 的
        STICK_BASE 常量、core/Joystick 的抓取判定是同一套，改这里必须同步改那里。
-->
<rml>
<head>
    <link type="text/rcss" href="rml.rcss"/>
    <link type="text/rcss" href="layout.rcss"/>
    <link type="text/rcss" href="default.rcss"/>
    <style>
        .bar_track { position: relative; background-color: #00000066; border-radius: 6dp; overflow: hidden; }
        .label { color: #ffffffd9; font-size: 22dp; }
        .big { color: #ffffffff; font-size: 64dp; font-weight: bold; }
    </style>
</head>
<body class="fullscreen">
<div data-model="{{__data_model_id}}">

    <!-- 左上：波次 + 防线血 + 局内成长（等级/经验条）。主角血不在这里——它改成了挂在人物
         头顶的 3 格血条（见 game/HpBar.lua + UI/HpBar.rml），这里不再留第二份显示，
         免得两个地方各自表达同一条血、不同步时说不清该信谁。 -->
    <div style="position: absolute; left: 28dp; top: 24dp; width: 300dp;">
        <div class="label">WAVE {{wave}}</div>
        <div class="label" style="margin-top: 8dp; font-size: 18dp; color: #ffffffb3;">防线</div>
        <progress class="horizontal" data-value="defense" style="display: block; margin-top: 2dp; width: 260dp; height: 14dp;"/>
        <div class="label" style="margin-top: 10dp; font-size: 24dp; color: #ffd24dff;">LV {{level}}</div>
        <progress class="horizontal" data-value="xp" style="display: block; margin-top: 4dp; width: 260dp; height: 10dp;"/>
        <div class="label" style="margin-top: 6dp; font-size: 18dp; color: #ffffff99;">{{narrate}}</div>
    </div>

    <!-- 右上：分数 + combo -->
    <div style="position: absolute; right: 28dp; top: 24dp; width: 220dp; text-align: right;">
        <div class="big">{{score}}</div>
        <div class="label" style="font-size: 30dp; color: #ffd24dff;">{{comboText}}</div>
    </div>

    <!-- 准星已移除：改为王者式自动吸附开火（见 Shooting.lua），命中确认靠下面的 hitmarker。 -->

    <!-- 性能 Overlay（调试）：靠 data-if="showPerf" 整体显隐，文本由 Lua 拼好喂 perfText。
         pointer-events:none 确保不吃点击。上线关（Config.PERF_OVERLAY=false）时根本不渲染。
         top 用 120dp 大幅下移避开手机刘海（居中这行正落在中置缺口区，64dp 仍被挡）；真机还挡就继续调大。 -->
    <div data-if="showPerf" style="position: absolute; left: 50%; top: 120dp; transform: translateX(-50%); pointer-events: none;">
        <div style="color: #7CFC00ff; font-size: 20dp; font-weight: bold;">{{perfText}}</div>
    </div>

    <!-- 中央 hitmarker：普通命中(白) / 强命中(红)，靠 data-if 二选一显示（不支持内联 opacity 绑定） -->
    <div data-if="hitNormal" style="position: absolute; left: 50%; top: 50%; width: 0; height: 0;">
        <div style="position: absolute; left: -18dp; top: -2dp; width: 36dp; height: 4dp; background-color: #ffffffd9; transform: rotate(45deg);"></div>
        <div style="position: absolute; left: -18dp; top: -2dp; width: 36dp; height: 4dp; background-color: #ffffffd9; transform: rotate(-45deg);"></div>
    </div>
    <div data-if="hitStrong" style="position: absolute; left: 50%; top: 50%; width: 0; height: 0;">
        <div style="position: absolute; left: -20dp; top: -3dp; width: 40dp; height: 6dp; background-color: #ff4d4dff; transform: rotate(45deg);"></div>
        <div style="position: absolute; left: -20dp; top: -3dp; width: 40dp; height: 6dp; background-color: #ff4d4dff; transform: rotate(-45deg);"></div>
    </div>

    <!-- 右下：载具交互按钮，靠 data-if 显隐（登船=靠近船，下船=在船上），见 main.lua/Hud.lua -->
    <div data-if="showBoard" data-event-click="board" style="position: absolute; right: 196dp; bottom: 168dp; width: 96dp; height: 96dp; border-radius: 48dp; background-color: #2e8b8be6; text-align: center;">
        <div style="position: relative; top: 32dp; color: #ffffffff; font-size: 30dp; font-weight: bold;">登船</div>
    </div>
    <div data-if="showDisembark" data-event-click="disembark" style="position: absolute; right: 196dp; bottom: 168dp; width: 96dp; height: 96dp; border-radius: 48dp; background-color: #8b6b2ee6; text-align: center;">
        <div style="position: relative; top: 32dp; color: #ffffffff; font-size: 30dp; font-weight: bold;">下船</div>
    </div>

    <!-- 右下：弹药 + 装弹条 + 当前武器（弹丸数，随成长变化） -->
    <div style="position: absolute; right: 40dp; bottom: 64dp; width: 200dp; text-align: right;">
        <div class="big">{{ammo}}</div>
        <progress class="horizontal" data-value="reload" style="display: block; margin-top: 6dp; margin-left: 40dp; width: 160dp; height: 10dp;"/>
        <div class="label" style="margin-top: 6dp; font-size: 20dp; color: #9fe0ffd9;">{{weaponText}}</div>
    </div>

    <!-- 左下：虚拟摇杆底环（几何与 Joystick 判定共用，勿单独改）。
         会动的只有 Knob.rml 那颗帽（Lua 逐帧 SetPosition）。这里原先套过一个深色内圆，
         看起来像帽却永远不动，极易被误认为“帽不跟手”，已移除。 -->
    <div id="stick_ring" style="position: absolute; left: 40dp; bottom: 40dp; width: 224dp; height: 224dp; border-radius: 112dp; background-color: #ffffff2e;"></div>

    <!-- 结算面板：data-if="gameOver"，未结束时整个不渲染 -->
    <div id="end_panel" data-if="gameOver" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000b3; text-align: center;">
        <div style="position: relative; top: 320dp;">
            <div style="color: #ffffffff; font-size: 72dp; font-weight: bold;">{{endTitle}}</div>
            <div class="label" style="margin-top: 16dp; font-size: 34dp;">SCORE {{endScore}}</div>
            <button data-event-click="restart" style="margin-top: 48dp; padding: 18dp 48dp; font-size: 30dp; background-color: #d94b3aff; color: #ffffffff; border-radius: 12dp;">再来一局</button>
        </div>
    </div>

</div>
</body>
</rml>
